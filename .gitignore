# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 依賴套件
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 測試
/coverage
*.lcov
.nyc_output/

# Next.js
/.next/
/out/

# 建置輸出
/build
/dist

# 快取檔案
.cache/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo

# 除錯檔案
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 環境變數 (可選擇性提交)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# 作業系統檔案
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp

# 編輯器與 IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
*.iml

# 其他
*.pem
*.key
.contentlayer
/public/sw.js
/public/workbox-*.js
